# Copy this file to .env and fill in your real values.
# .env is gitignored. NEVER commit real keys.
#
# Get these from https://app.alpaca.markets/paper/dashboard/overview
# Use the PAPER account keys. It is free, needs no credit card, and cannot
# place real-money orders.

ALPACA_API_KEY_ID=PKXXXXXXXXXXXXXXXXXX
ALPACA_API_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: where volcast caches downloaded price data.
# VOLCAST_CACHE_DIR=.volcast/cache
